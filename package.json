{
  "name": "hugame-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:downloads",
    "build:cli": "node scripts/build-cli.mjs",
    "build:downloads": "tsx scripts/build-downloads.ts",
    "test": "npm run typecheck && npm run test:cli",
    "test:cli": "npm run build:cli && node --test test/cli.contract.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
